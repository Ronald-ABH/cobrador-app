# Copia este archivo a ".env" y completa tus propios valores.
# cp .env.example .env

# Frase larga y única para firmar las sesiones (JWT). Cámbiala por algo tuyo.
JWT_SECRET=cambia-esto-por-una-frase-larga-y-unica

# Usuario y contraseña con los que vas a entrar la primera vez.
# Puedes cambiar la contraseña luego desde Ajustes → Seguridad.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin123

# Zona horaria usada para "hoy" (agenda, reportes) y para la hora del
# backup diario. No suele hacer falta cambiarla.
APP_TIMEZONE=America/Bogota

# --- Copia de seguridad por correo (opcional en desarrollo local) ---
# Clave de la API de Resend (resend.com → API Keys). Si la dejas vacía,
# el backup simplemente no se envía (no da error).
RESEND_API_KEY=
# Correo(s) que van a recibir la copia de seguridad diaria.
BACKUP_EMAIL_TO=
# Remitente del correo de backup (opcional; por defecto usa un remitente
# de prueba de Resend que no requiere configuración).
# RESEND_FROM=Cobrador App <onboarding@resend.dev>
# Hora del backup diario en formato cron (por defecto 11:59pm).
# BACKUP_CRON=59 23 * * *

# Carpeta donde vive la base de datos SQLite. En Railway se apunta a un
# Volume montado (ej. /data) para que los datos no se pierdan. En
# desarrollo local puedes dejarla vacía: se usa una carpeta del proyecto.
# DATA_DIR=/data
